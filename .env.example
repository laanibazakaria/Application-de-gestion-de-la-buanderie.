# =============================================================================
#  Buanderie de l'internat — variables d'environnement
#  Copier ce fichier en « .env » pour le développement local.
#  En production (Vercel), définir ces variables dans Project → Settings →
#  Environment Variables (l'intégration Neon crée les deux premières).
# =============================================================================

# --- Base de données (obligatoire) -------------------------------------------
# Production : chaîne « pooled » fournie par Neon (hôte contenant « -pooler »),
#              créée automatiquement par l'intégration Neon de Vercel.
# Local      : PostgreSQL 16 sur la machine.
DATABASE_URL=postgres://buanderie:buanderie@localhost:5432/buanderie_dev

# Connexion DIRECTE (sans pooler), utilisée uniquement par les migrations.
# Créée automatiquement par l'intégration Neon. Facultative en local.
# DATABASE_URL_UNPOOLED=

# --- Sécurité (obligatoire) ----------------------------------------------------
# Secret partagé avec cron-job.org (en-tête « Authorization: Bearer <secret> »)
# pour appeler /api/cron/settle. Au moins 32 caractères.
# Générer avec : openssl rand -hex 32
CRON_SECRET=remplacer-par-le-resultat-de-openssl-rand-hex-32

# URL publique de l'application, sans « / » final (ex. : https://buanderie.vercel.app).
# Sert à vérifier l'origine des requêtes (protection CSRF).
APP_URL=http://localhost:3000

# --- Tests uniquement ----------------------------------------------------------
# Bases VIDÉES par les tests : elles doivent obligatoirement être sur localhost.
TEST_DATABASE_URL=postgres://buanderie:buanderie@localhost:5432/buanderie_test
E2E_DATABASE_URL=postgres://buanderie:buanderie@localhost:5432/buanderie_e2e

# Horloge simulée (/api/test/clock) : activée automatiquement par les tests.
# Ne JAMAIS la définir en production — elle y serait de toute façon ignorée
# (voir docs/ARCHITECTURE.md, « Horloge de test »).
# E2E_TEST_CLOCK=1

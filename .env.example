# --- Base de données -------------------------------------------------------
# Production (Vercel + Neon) : chaîne de connexion « pooled » fournie par Neon
# (hôte contenant « -pooler »). L'intégration Neon de Vercel la crée toute seule.
# Développement local : un PostgreSQL 16 sur la machine.
DATABASE_URL=postgres://buanderie:buanderie@localhost:5432/buanderie_dev

# Base utilisée par les tests d'intégration et de bout en bout (sera VIDÉE).
# Doit obligatoirement pointer vers localhost.
TEST_DATABASE_URL=postgres://buanderie:buanderie@localhost:5432/buanderie_test

# --- Sécurité --------------------------------------------------------------
# Secret partagé avec cron-job.org pour appeler /api/cron/settle.
# Générer avec : openssl rand -hex 32
CRON_SECRET=change-me-with-openssl-rand-hex-32

# URL publique de l'application (utilisée pour la vérification de l'origine des requêtes).
APP_URL=http://localhost:3000

# --- Tests de bout en bout uniquement ---------------------------------------
# Active la route /api/test/clock (horloge simulée). Ignorée en production :
# voir docs/ARCHITECTURE.md, section « Horloge de test ».
# E2E_TEST_CLOCK=1
